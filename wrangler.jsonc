// Cloudflare Workers config: serves public/ and runs worker.js for the contact form.
// Secrets (not in this file): RESEND_API_KEY. Set it with `npx wrangler secret put RESEND_API_KEY`
// or in the Cloudflare dashboard → Workers → elporvenir → Settings → Variables and secrets.
{
  "name": "elporvenir",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
